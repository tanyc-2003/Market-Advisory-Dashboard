# Database paths
MAIN_DB_PATH=data/db/main.duckdb
AUDIT_DB_PATH=data/db/audit.duckdb
CACHE_DIR=data/cache/features

# API keys (leave empty for stub/dev mode)
POLYGON_API_KEY=
SHARADAR_API_KEY=
FRED_API_KEY=

# Validation thresholds
WF_SHARPE_FLOOR=0.5
WF_ECE_CEILING=0.05
CPCV_P30_FLOOR=0.0
DSR_FLOOR=0.95
STATIC_TRIAL_FLOOR=2000
DIVERGENCE_THRESHOLD=0.30

# Feature engineering
UNIVERSE_SIZE=100
EWMA_CLIP=4.0

# Optional LLM
LLM_ENABLED=false
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# V7_lite extension
# "v7_lite" (default) uses free yfinance + FRED + CBOE data.
# "v7_institutional" uses paid Polygon + Sharadar.  If those keys are
# missing, the system falls back to synthetic data with a "Developer
# Mode" badge.
APP_MODE=v7_lite

# V7_lite thresholds (architecture-pinned)
DIVERGENCE_THRESHOLD_LITE=0.40
MAX_MISSING_BAR_FRACTION=0.02
MAX_STALE_CROSS_TICKER_FRACTION=0.20
ANNUAL_IMPAIRMENT_RATE=0.02
SYNTHETIC_WIPEOUT_RETURN=-0.60
