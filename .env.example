# Database paths
MAIN_DB_PATH=data/db/main.duckdb
AUDIT_DB_PATH=data/db/audit.duckdb
CACHE_DIR=data/cache/features

# API keys (leave empty for stub/dev mode)
POLYGON_API_KEY=
SHARADAR_API_KEY=
FRED_API_KEY=

# Validation thresholds
WF_SHARPE_FLOOR=0.5
WF_ECE_CEILING=0.05
CPCV_P30_FLOOR=0.0
DSR_FLOOR=0.95
STATIC_TRIAL_FLOOR=2000
DIVERGENCE_THRESHOLD=0.30

# Feature engineering
UNIVERSE_SIZE=100
EWMA_CLIP=4.0

# Optional LLM
LLM_ENABLED=false
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
